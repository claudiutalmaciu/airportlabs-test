APP_NAME="Gate Scheduler"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gates
DB_USERNAME=gates
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nothing is queued: work runs immediately, and there is no failed-jobs table.
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gate allocation
AIRPORT_ICAO=LRCL
GATE_COUNT=20
GATE_OCCUPANCY_MINUTES=90
GATE_WINDOW_STRATEGY=flight_time
FETCH_LOOKBACK_HOURS=48
LIVE_MAP_RADIUS_KM=80
LIVE_MAP_REFRESH_SECONDS=60
FETCH_CRON="*/10 * * * *"
VALIDATE_CRON="*/15 * * * *"

# OpenSky (OAuth2 client credentials; flights endpoints return 403 without them)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
